BOT_TOKEN=<BotFather token>
OKPAY_SHOP_ID=<OKPay App ID>
OKPAY_API_KEY=<OKPay API key>
PUBLIC_BASE_URL=https://pay.example.com
WALLET_DB=/opt/searchbot/wallet.sqlite3

# Paid on-demand downloads
GAME_PRICE_UNITS=10000000
BT_PRICE_UNITS=10000000
BT_MAX_BYTES=2000000000
BT_DISK_RESERVE_BYTES=1073741824
BT_DOWNLOAD_TIMEOUT=21600
DOWNLOAD_DIR=/opt/searchbot/downloads
STORAGE_CHANNEL_ID=-1001234567890
UPLOADER_SESSION=/opt/searchbot/uploader.session
RYUUGAMES_ARCHIVE_PASSWORDS=ryuugames.com,www.ryuugames.com
OTOMI_ARCHIVE_PASSWORDS=otomi-games.com,www.otomi-games.com

# Local admin panel (use a random value of at least 16 chars)
ADMIN_TOKEN=<strong random admin password>
